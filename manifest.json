{
  "manifest_version": 2,
  "name": "Switcher (jamietre fork)",
  "version": "2.0.1.1",
  "author": "Vahid Heidari (fork maintained by jamietre)",
  "developer": {
    "name": "Vahid Heidari",
    "url": "https://github.com/vheidari"
  },

  "homepage_url": "https://github.com/jamietre/Switcher",
  "description": "A Proxy Settings Switcher for Firefox. Fork of vheidari/switcher with proxy-state fixes.",

  "icons": {
    "32": "src/images/icons/tunnel_c_32x32.png"
  },

  "commands": {
    "switch": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Switch to system proxy, no proxy, and manual proxy mode in Firefox."
    }
  },

  "permissions": ["proxy"],

  "browser_specific_settings": {
    "gecko": {
      "id": "switcher-fork@jamietre.github.io",
      "strict_min_version": "91.1.0"
    }
  },

  "omnibox": {
    "keyword": "switcher"
  },

  "browser_action": {
    "default_icon": {
      "32": "src/images/icons/tunnel_c_32x32.png"
    },
    "default_title": "Switcher (fork)",
    "default_popup": "src/panel/Switcher.html"
  },

  "background": {
    "scripts": [
      "src/scripts/browser_actions.js",
      "src/scripts/background_startup.js",
      "src/scripts/background_events.js",
      "src/scripts/panel_functions.js",
      "src/scripts/panel_events.js"
    ]
  }
}
